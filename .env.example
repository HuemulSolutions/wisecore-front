# Backend API base URL (required)
VITE_API_URL=http://localhost:8080/api/v1

# Enable logger.log / logger.warn output in the browser console (optional, 'true' to enable)
VITE_SHOW_IN_CONSOLE=false

# Legal links shown on the login screen (optional; omitted = plain text, no link)
VITE_TERMS_URL=
VITE_PRIVACY_URL=
